ENVIRONMENT=development
DEBUG=true
SECRET_KEY=dev-only-change-me
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Local dev defaults: SQLite + Celery/cache in memory. No Postgres/Redis needed.
DATABASE_URL=sqlite:///db.sqlite3
USE_POSTGRES_IN_DEBUG=false
REDIS_URL=redis://localhost:6379/0
USE_REDIS_IN_DEBUG=false
REDIS_REQUIRED=false

UPLOAD_MAX_SIZE_MB=10
UPLOAD_RATE_LIMIT_PER_MINUTE=20
UPLOAD_RATE_LIMIT_PER_HOUR=60
EVENT_RETENTION_DAYS=90
ALERT_OCR_QUEUE_PENDING=50
ALERT_CPU_PERCENT=85
ALERT_DISK_PERCENT=80
ALERT_OCR_ERROR_RATE_PERCENT=20

INGEST_PUBLIC_BASE_URL=http://localhost:8000
INGEST_MAX_IMAGE_SIZE_MB=10
INGEST_REQUIRE_CAMERA_TOKEN=true
INGEST_REQUIRE_GATEWAY_TOKEN=true
INGEST_RATE_LIMIT_CAMERA_PER_MINUTE=60
INGEST_RATE_LIMIT_GATEWAY_PER_MINUTE=120

EDGE_GATEWAY_HEARTBEAT_INTERVAL_SECONDS=30
EDGE_GATEWAY_LOCAL_QUEUE_ENABLED=true
EDGE_GATEWAY_LOCAL_QUEUE_MAX_EVENTS=10000
EDGE_GATEWAY_RETRY_INTERVAL_SECONDS=15

UNKNOWN_PLATE_AUTO_CREATE=true
UNKNOWN_PLATE_MIN_CONFIDENCE=0.70
BLACKLIST_ALERT_ENABLED=true
UNKNOWN_ALERT_ENABLED=true

DEFAULT_CAMERA_TIMEZONE=America/Sao_Paulo
PLATE_NORMALIZATION_COUNTRY=BR

CELERY_OCR_CONCURRENCY=2
CELERY_CAPTURE_CONCURRENCY=4
CELERY_REPORT_CONCURRENCY=1
CELERY_OCR_MAX_RETRIES=3
CELERY_DEV_EAGER=true

TASK_TIME_LIMIT_OCR=120
TASK_SOFT_TIME_LIMIT_OCR=90

RTSP_CONNECTION_TIMEOUT=10
RTSP_READ_TIMEOUT=30

# MediaMTX (RTSP + RTMP media server)
# run: python manage.py run_media_server
MEDIAMTX_BINARY=mediamtx
MEDIAMTX_CONFIG=/tmp/mediamtx.yml
MEDIAMTX_HOST=localhost
MEDIAMTX_RTSP_PORT=8554
MEDIAMTX_RTMP_PORT=1935
MEDIAMTX_HLS_PORT=8888
MEDIAMTX_API_PORT=9997
MEDIAMTX_LOG_LEVEL=info
MEDIAMTX_WATCH_INTERVAL=10

# Captura de frames das câmeras → OCR
CAPTURE_INTERVAL_SECONDS=2

# Simulador de câmera (run_camera_simulator / docker compose --profile simulator)
# SIMULATOR_CAMERA_KEY deve ser o camera_key de uma câmera rtmp_push ativa
SIMULATOR_CAMERA_KEY=

JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

YOLO_MODEL_VERSION=lpr-v1.pt
OCR_ENGINE_VERSION=stub-0.1

DEAD_LETTER_WEBHOOK_URL=
FIELD_ENCRYPTION_KEY=

POSTGRES_DB=lpr_db
POSTGRES_USER=lpr_user
POSTGRES_PASSWORD=lpr_password

# Superusuario + business + tenant iniciais
# Usado pelo comando: python manage.py createadminuser
SUPERUSER_USERNAME=admin
SUPERUSER_EMAIL=admin@example.com
SUPERUSER_PASSWORD=changeme

SETUP_BUSINESS_NAME=starLPR
SETUP_BUSINESS_LEGAL_NAME=starLPR Tecnologia Ltda
SETUP_BUSINESS_DOCUMENT=

SETUP_TENANT_NAME=Unidade Principal
SETUP_TENANT_SLUG=principal
SETUP_TENANT_LOCATION=
SETUP_TENANT_TIMEZONE=America/Sao_Paulo

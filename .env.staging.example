ENVIRONMENT=staging
DEBUG=false
SECRET_KEY=replace-with-staging-secret
ALLOWED_HOSTS=staging.example.com
CSRF_TRUSTED_ORIGINS=https://staging.example.com

DATABASE_URL=postgres://lpr_user:replace@db:5432/lpr_db
USE_POSTGRES_IN_DEBUG=false
REDIS_URL=redis://redis:6379/0
USE_REDIS_IN_DEBUG=false
REDIS_REQUIRED=true

UPLOAD_MAX_SIZE_MB=10
UPLOAD_RATE_LIMIT_PER_MINUTE=20
UPLOAD_RATE_LIMIT_PER_HOUR=60
EVENT_RETENTION_DAYS=90
ALERT_OCR_QUEUE_PENDING=50
ALERT_CPU_PERCENT=85
ALERT_DISK_PERCENT=80
ALERT_OCR_ERROR_RATE_PERCENT=20

INGEST_PUBLIC_BASE_URL=https://staging.example.com
INGEST_MAX_IMAGE_SIZE_MB=10
INGEST_REQUIRE_CAMERA_TOKEN=true
INGEST_REQUIRE_GATEWAY_TOKEN=true
INGEST_RATE_LIMIT_CAMERA_PER_MINUTE=60
INGEST_RATE_LIMIT_GATEWAY_PER_MINUTE=120

EDGE_GATEWAY_HEARTBEAT_INTERVAL_SECONDS=30
EDGE_GATEWAY_LOCAL_QUEUE_ENABLED=true
EDGE_GATEWAY_LOCAL_QUEUE_MAX_EVENTS=10000
EDGE_GATEWAY_RETRY_INTERVAL_SECONDS=15

UNKNOWN_PLATE_AUTO_CREATE=true
UNKNOWN_PLATE_MIN_CONFIDENCE=0.70
BLACKLIST_ALERT_ENABLED=true
UNKNOWN_ALERT_ENABLED=true

DEFAULT_CAMERA_TIMEZONE=America/Sao_Paulo
PLATE_NORMALIZATION_COUNTRY=BR

CELERY_OCR_CONCURRENCY=2
CELERY_CAPTURE_CONCURRENCY=4
CELERY_REPORT_CONCURRENCY=1
CELERY_OCR_MAX_RETRIES=3
CELERY_DEV_EAGER=false

TASK_TIME_LIMIT_OCR=120
TASK_SOFT_TIME_LIMIT_OCR=90

RTSP_CONNECTION_TIMEOUT=10
RTSP_READ_TIMEOUT=30

JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

YOLO_MODEL_VERSION=lpr-v1.pt
OCR_ENGINE_VERSION=stub-0.1

DEAD_LETTER_WEBHOOK_URL=
FIELD_ENCRYPTION_KEY=replace-with-fernet-or-secret

POSTGRES_DB=lpr_db
POSTGRES_USER=lpr_user
POSTGRES_PASSWORD=replace
